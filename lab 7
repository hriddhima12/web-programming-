<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lab 7 - Calculator</title>
<style>
  body { font-family: Georgia, serif; background: #eef2f5; display: flex; justify-content: center; padding: 40px 16px; margin: 0; }
  .box { background: #fff; border: 2px solid #1d3557; border-radius: 6px; padding: 28px; width: 100%; max-width: 380px; }
  h1 { font-size: 22px; margin: 0 0 20px; color: #1d3557; }
  label { display: block; margin: 12px 0 4px; font-size: 14px; }
  input, select { width: 100%; padding: 9px; font-size: 16px; border: 1px solid #888; border-radius: 4px; box-sizing: border-box; }
  .btns { display: flex; gap: 8px; margin-top: 18px; }
  button { flex: 1; padding: 10px; font-size: 15px; border: 0; border-radius: 4px; background: #1d3557; color: #fff; cursor: pointer; }
  button.reset { background: #777; }
  button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid #e63946; outline-offset: 1px; }
  #result { margin-top: 20px; padding: 12px; background: #f1faee; border-left: 4px solid #1d3557; font-size: 18px; min-height: 24px; }
  #result.error { background: #fdecea; border-color: #e63946; color: #b00020; }
</style>
</head>
<body>
<div class="box">
  <h1>Simple Calculator</h1>
  <form id="calcForm" onsubmit="return false;">
    <label for="num1">First number</label>
    <input type="number" id="num1" step="any" placeholder="Enter first number">

    <label for="num2">Second number</label>
    <input type="number" id="num2" step="any" placeholder="Enter second number">

    <label for="op">Operation</label>
    <select id="op">
      <option value="+">Addition (+)</option>
      <option value="-">Subtraction (-)</option>
      <option value="*">Multiplication (*)</option>
      <option value="/">Division (/)</option>
    </select>

    <div class="btns">
      <button type="button" onclick="calculate()">Calculate</button>
      <button type="button" class="reset" onclick="resetForm()">Clear</button>
    </div>
  </form>
  <div id="result"></div>
</div>

<script>
  function calculate() {
    var a = document.getElementById("num1").value;
    var b = document.getElementById("num2").value;
    var op = document.getElementById("op").value;
    var out = document.getElementById("result");
    out.className = "";

    if (a === "" || b === "") {
      out.className = "error";
      out.textContent = "Please enter both numbers.";
      return;
    }

    a = parseFloat(a);
    b = parseFloat(b);
    var result;

    switch (op) {
      case "+": result = a + b; break;
      case "-": result = a - b; break;
      case "*": result = a * b; break;
      case "/":
        if (b === 0) {
          out.className = "error";
          out.textContent = "Cannot divide by zero.";
          return;
        }
        result = a / b;
        break;
    }
    out.textContent = a + " " + op + " " + b + " = " + result;
  }

  function resetForm() {
    document.getElementById("calcForm").reset();
    document.getElementById("result").textContent = "";
    document.getElementById("result").className = "";
  }
</script>
</body>
</html>
